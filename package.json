{
	"name": "stepik-vscode-fork",
	"displayName": "Stepik Fork",
	"description": "Fork of Stepik for VS Code: solve Stepik problems, read discussions and post comments",
	"author": "Danil Proskurin (꧁༒☬𝔉𝔜𝔡𝔡𝔡𝔡𝔰𝔰☬༒꧂)",
	"version": "0.4.11",
	"publisher": "FYddddss",
	"license": "GPL-3.0-only",
	"icon": "resources/icon.png",
	"galleryBanner": {
		"color": "#54ad54",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Education",
		"Other"
	],
	"keywords": [
		"stepik",
		"education",
		"python",
		"courses",
		"comments",
		"fork"
	],
	"activationEvents": [
		"onStartupFinished",
		"onView:stepikCourses",
		"onCommand:stepik.login",
		"onCommand:stepik.selectCourse",
		"onCommand:stepik.browseCourses",
		"onCommand:stepik.showNotifications",
		"onCommand:stepik.showProfile",
		"onCommand:stepik.startExam",
		"onCommand:stepik.changeLanguage"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "stepik.login",
				"title": "Stepik: Login",
				"icon": "$(sign-in)"
			},
			{
				"command": "stepik.logout",
				"title": "Stepik: Logout",
				"icon": "$(sign-out)"
			},
			{
				"command": "stepik.archiveAccount",
				"title": "Stepik: Archive Account Solutions",
				"icon": "$(archive)"
			},
			{
				"command": "stepik.refresh",
				"title": "Stepik: Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "stepik.openStep",
				"title": "Stepik: Open Step"
			},
			{
				"command": "stepik.startExam",
				"title": "Stepik: Start Exam",
				"icon": "$(play)"
			},
			{
				"command": "stepik.submit",
				"title": "Stepik: Submit Solution",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "stepik.selectCourse",
				"title": "Stepik: Select Course",
				"icon": "$(book)"
			},
			{
				"command": "stepik.browseCourses",
				"title": "Stepik: Browse Courses",
				"icon": "$(search)"
			},
			{
				"command": "stepik.showNotifications",
				"title": "Stepik: Show Notifications",
				"icon": "$(bell)"
			},
			{
				"command": "stepik.showProfile",
				"title": "Stepik: Show Profile",
				"icon": "$(account)"
			},
			{
				"command": "stepik.changeLanguage",
				"title": "Stepik: Change Interface Language",
				"icon": "$(globe)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "stepik",
					"title": "Stepik Fork",
					"icon": "resources/stepik.svg"
				}
			]
		},
		"views": {
			"stepik": [
				{
					"icon": "resources/stepik-badge.svg",
					"id": "stepikCourses",
					"name": "Courses"
				}
			]
		},
		"menus": {
			"commandPalette": [
				{
					"command": "stepik.openStep",
					"when": "false"
				},
				{
					"command": "stepik.startExam",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "stepik.showNotifications",
					"when": "view == stepikCourses",
					"group": "navigation@0"
				},
				{
					"command": "stepik.showProfile",
					"when": "view == stepikCourses",
					"group": "navigation@1"
				},
				{
					"command": "stepik.selectCourse",
					"when": "view == stepikCourses",
					"group": "navigation@2"
				},
				{
					"command": "stepik.refresh",
					"when": "view == stepikCourses",
					"group": "navigation@3"
				},
				{
					"command": "stepik.logout",
					"when": "view == stepikCourses",
					"group": "navigation@4"
				},
				{
					"command": "stepik.login",
					"when": "view == stepikCourses",
					"group": "navigation@5"
				},
				{
					"command": "stepik.changeLanguage",
					"when": "view == stepikCourses",
					"group": "navigation@6"
				}
			],
			"editor/title": [
				{
					"command": "stepik.submit",
					"when": "resourceScheme == file",
					"group": "navigation"
				}
			]
		},
		"configuration": {
			"title": "Stepik",
			"properties": {
				"stepik.language": {
					"type": "string",
					"enum": [
						"auto",
						"ru",
						"en"
					],
					"enumDescriptions": [
						"Follow the VS Code display language",
						"Русский",
						"English"
					],
					"default": "auto",
					"description": "Interface language for Stepik panels, notifications, profile and catalog.",
					"scope": "window"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run build",
		"build": "esbuild ./src/extension.ts ./src/audio/audioWorker.ts --bundle --outdir=dist --entry-names=[name] --external:vscode --format=cjs --platform=node --minify",
		"watch": "esbuild ./src/extension.ts ./src/audio/audioWorker.ts --bundle --outdir=dist --entry-names=[name] --external:vscode --format=cjs --platform=node --sourcemap --watch",
		"lint": "eslint src --ext ts"
	},
	"devDependencies": {
		"@types/adm-zip": "^0.5.8",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^20.10.0",
		"@types/turndown": "^5.0.6",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^6.13.0",
		"@typescript-eslint/parser": "^6.13.0",
		"esbuild": "^0.19.8",
		"eslint": "^8.54.0",
		"typescript": "^5.3.2"
	},
	"dependencies": {
		"@audio/decode-mp4": "^1.3.1",
		"adm-zip": "^0.6.1",
		"highlight.js": "^11.12.0",
		"katex": "^0.16.47",
		"markdown-it": "^14.3.3",
		"node-fetch": "^3.3.2",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"wasm-media-encoders": "^0.7.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/danilproskurin291-cmd/stepik-vscode.git"
	},
	"homepage": "https://github.com/danilproskurin291-cmd/stepik-vscode#readme",
	"bugs": {
		"url": "https://github.com/danilproskurin291-cmd/stepik-vscode/issues"
	}
}
